const DRINKS_SHEET_ID = "1LLsZireCOfRgnGtK3NWST5i_ntu-BBjO88qoG2xkMl4";
const DRINKS_SHEET_TAB = "Respostas";

function doGet(e) {
  const args = (e && e.parameter) || {};
  const callback = String(args.callback || "");
  // JSONP: only allow callback names generated by the wedding website.
  if (!/^__drinkCb[a-z0-9]{8,50}$/.test(callback)) {
    return ContentService.createTextOutput("/* invalid callback */")
      .setMimeType(ContentService.MimeType.JAVASCRIPT);
  }

  let result;
  try {
    result = saveDrinkVote_(String(args.data || ""));
  } catch (error) {
    console.error("Vote rejected: " + String(error));
    result = {status: "error", message: "Unable to save response"};
  }
  return ContentService.createTextOutput(callback + "(" + JSON.stringify(result) + ");")
    .setMimeType(ContentService.MimeType.JAVASCRIPT);
}

function saveDrinkVote_(raw) {
  if (!raw || raw.length > 2400) throw new Error("Invalid payload size");
  const vote = JSON.parse(raw);
  if (!vote || typeof vote !== "object" || Array.isArray(vote)) throw new Error("Invalid vote");
  const id = String(vote.id || "");
  if (!/^[a-z0-9-]{12,100}$/i.test(id)) throw new Error("Invalid response ID");

  const sober = vote.sober === true;
  const values = ["chope", "white", "red", "sparkling"].map(function (key) {
    const value = vote[key];
    if (typeof value !== "number" || !Number.isInteger(value) || value < 0 || value > 100)
      throw new Error("Invalid percentage: " + key);
    return value;
  });
  const total = values.reduce(function (sum, val) { return sum + val; }, 0);
  if (sober && total !== 0) throw new Error("Non-drinker must have zero percentages");
  if (!sober && total !== 100) throw new Error("Percentages must total 100");

  let name = typeof vote.name === "string" ? vote.name : "";
  name = name.replace(/[\x00-\x1f\x7f]/g, " ").trim().slice(0, 100);
  // Prevent user-entered text from becoming a spreadsheet formula.
  if (/^[=+@\-]/.test(name)) name = "'" + name;

  const lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try {
    const sheet = SpreadsheetApp.openById(DRINKS_SHEET_ID).getSheetByName(DRINKS_SHEET_TAB);
    if (!sheet) throw new Error("Response sheet not found");
    const lastRow = sheet.getLastRow();

    // A repeated request ID is safe to retry without creating another row.
    if (lastRow > 1 && sheet.getRange(2, 9, lastRow - 1, 1)
      .createTextFinder(id).matchEntireCell(true).findNext()) {
      return {status: "ok", duplicate: true};
    }

    sheet.appendRow([
      new Date(), name, values[0], values[1], values[2], values[3],
      sober ? "Sim" : "Não", total, id
    ]);
    SpreadsheetApp.flush();
    return {status: "ok", duplicate: false};
  } finally {
    lock.releaseLock();
  }
}
